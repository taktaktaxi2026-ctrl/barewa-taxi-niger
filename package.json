{
  "name": "boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "gen:types": "node scripts/generate-product-types.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint . --fix --quiet --no-color",
    "build": "NO_COLOR=1 NODE_ENV=production vite build --configLoader runner",
    "test": "vitest run --passWithNoTests --configLoader runner",
    "bundle:action": "node scripts/bundle-code-action.mjs",
    "test:action": " NO_COLOR=1 node scripts/test-code-action.mjs",
    "knip": "knip",
    "dev": "VITE_BUILD_STANDALONE=1 vite --configLoader runner",
    "preview": "VITE_BUILD_STANDALONE=1 vite build --configLoader runner && vite preview --configLoader runner"
  },
  "pnpm": {
