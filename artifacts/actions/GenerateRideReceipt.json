{
  "name": "GenerateRideReceipt",
  "type": "dag",
  "description": "Produit le reçu officiel de transport BAREWA en PDF pour une course terminée : mentions légales de la société (raison sociale, NIF, RCCM), numéro de reçu, détail du trajet, ventilation du montant en FCFA avec la TVA, moyen de paiement et référence de transaction. Le même PDF sert à l'aperçu, au téléchargement et à l'envoi — il n'existe qu'un seul modèle.",
  "iconName": "receipt-text",
  "exposedToUI": true,
  "inputSchema": {
    "type": "object",
    "required": [
      "receiptNumber",
      "rideReference",
      "issuedOn",
      "passengerName",
      "driverName",
      "pickupLabel",
      "dropoffLabel",
      "totalAmount"
    ],
    "properties": {
      "receiptNumber": {
        "type": "string",
        "description": "Numéro du reçu officiel (ex. REC-2026-000143)"
      },
      "rideReference": {
        "type": "string",
        "description": "Référence de la course (ex. BRW-4F92K)"
      },
      "issuedOn": {
        "type": "string",
        "description": "Date et heure d'émission en heure du Niger, déjà formatées pour l'impression (ex. 07/09/2026 à 18:42)"
      },
      "cityName": {
        "type": "string",
        "description": "Ville de la course",
        "default": ""
      },
      "passengerName": {
        "type": "string",
        "description": "Nom du passager"
      },
      "passengerPhone": {
        "type": "string",
        "description": "Téléphone du passager",
        "default": ""
      },
      "driverName": {
        "type": "string",
        "description": "Nom du chauffeur"
      },
      "driverPhone": {
        "type": "string",
        "description": "Téléphone du chauffeur",
        "default": ""
      },
      "vehicleLabel": {
        "type": "string",
        "description": "Véhicule et immatriculation (ex. Toyota Starlet · NI 4821 AB)",
        "default": ""
      },
      "pickupLabel": {
        "type": "string",
        "description": "Point de départ"
      },
      "dropoffLabel": {
        "type": "string",
        "description": "Point d'arrivée"
      },
      "distanceLabel": {
        "type": "string",
        "description": "Distance parcourue déjà formatée (ex. 7,4 km)",
        "default": ""
      },
      "durationLabel": {
        "type": "string",
        "description": "Durée du trajet déjà formatée (ex. 21 min)",
        "default": ""
      },
      "baseAmountLabel": {
        "type": "string",
        "description": "Montant hors remise, formaté en FCFA avec séparateur de milliers",
        "default": ""
      },
      "discountLabel": {
        "type": "string",
        "description": "Remise accordée, formatée en FCFA ; chaîne vide s'il n'y en a pas",
        "default": ""
      },
      "surchargeLabel": {
        "type": "string",
        "description": "Majoration appliquée (nuit, heure de pointe), formatée ; chaîne vide s'il n'y en a pas",
        "default": ""
      },
      "vatRateLabel": {
        "type": "string",
        "description": "Taux de TVA affiché (ex. 0 %)",
        "default": "0 %"
      },
      "vatAmountLabel": {
        "type": "string",
        "description": "Montant de TVA, formaté en FCFA",
        "default": "0 FCFA"
      },
      "totalAmount": {
        "type": "string",
        "description": "Montant total réglé, formaté en FCFA avec séparateur de milliers (ex. 2 500 FCFA)"
      },
      "paymentMethod": {
        "type": "string",
        "description": "Moyen de paiement utilisé",
        "default": ""
      },
      "transactionReference": {
        "type": "string",
        "description": "Référence de transaction de l'opérateur mobile money",
        "default": ""
      },
      "paymentStatus": {
        "type": "string",
        "description": "État du règlement au moment de l'émission",
        "default": ""
      },
      "companyLegalName": {
        "type": "string",
        "description": "Raison sociale de la société",
        "default": "BAREWA TAXI NIGER SARL"
      },
      "companyNif": {
        "type": "string",
        "description": "Numéro d'identification fiscale",
        "default": ""
      },
      "companyRccm": {
        "type": "string",
        "description": "Numéro au registre du commerce",
        "default": ""
      },
      "companyAddress": {
        "type": "string",
        "description": "Adresse du siège",
        "default": ""
      },
      "companyCity": {
        "type": "string",
        "description": "Ville et pays du siège",
        "default": "Niamey, Niger"
      },
      "companyPhone": {
        "type": "string",
        "description": "Téléphone officiel de la société",
        "default": ""
      },
      "companyEmail": {
        "type": "string",
        "description": "Adresse électronique officielle",
        "default": ""
      }
    }
  },
  "output": "RenderReceiptPdf",
  "actionNodes": [
    {
      "name": "ComposeReceiptHtml",
